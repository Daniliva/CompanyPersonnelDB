@model IEnumerable<Project.Models.Employee>
@using Project.Models
@{
    ViewData["Title"] = "Employees";
    var departmentId = Context.Request.Query["departmentId"].ToString();
    var positionId = Context.Request.Query["positionId"].ToString();
    var lastName = Context.Request.Query["lastName"].ToString();
    var firstName = Context.Request.Query["firstName"].ToString();
    var middleName = Context.Request.Query["middleName"].ToString();
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-4 text-center mb-4">Employee List</h1>
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in (ViewBag.Departments as List<Department> ?? new List<Department>()))
                    {
                        <option value="@dept.DepartmentId" selected="@(dept.DepartmentId.ToString() == departmentId)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Position</label>
                <select name="positionId" class="form-select">
                    <option value="">All Positions</option>
                    @foreach (var pos in (ViewBag.Positions as List<Position> ?? new List<Position>()))
                    {
                        <option value="@pos.PositionId" selected="@(pos.PositionId.ToString() == positionId)">@pos.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Last Name</label>
                <input name="lastName" class="form-control" placeholder="Enter last name" value="@lastName" />
            </div>
            <div class="col-md-2">
                <label class="form-label">First Name</label>
                <input name="firstName" class="form-control" placeholder="Enter first name" value="@firstName" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Middle Name</label>
                <input name="middleName" class="form-control" placeholder="Enter middle name" value="@middleName" />
            </div>
            <div class="col-md-12 mt-3">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-secondary">Clear Filters</a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Employee ID</th>
                    <th>Last Name</th>
                    <th>First Name</th>
                    <th>Middle Name</th>
                    <th>Hire Date</th>
                    <th>Salary</th>
                    <th>Department</th>
                    <th>Position</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
                    var positions = ViewBag.Positions as List<Position> ?? new List<Position>();
                    @foreach (var employee in Model)
                    {
                        var dept = departments.FirstOrDefault(d => d.DepartmentId == employee.DepartmentId);
                        var pos = positions.FirstOrDefault(p => p.PositionId == employee.PositionId);
                        <tr>
                            <td>@employee.EmployeeId</td>
                            <td>@employee.LastName</td>
                            <td>@employee.FirstName</td>
                            <td>@employee.MiddleName</td>
                            <td>@employee.HireDate.ToShortDateString()</td>
                            <td>@employee.Salary.ToString("C")</td>
                            <td>@(dept?.Name ?? "N/A")</td>
                            <td>@(pos?.Name ?? "N/A")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No employees found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
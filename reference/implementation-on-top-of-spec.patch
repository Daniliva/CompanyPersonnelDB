--- a/src/Project/DataAccess/EmployeeQueryBuilder.cs
+++ b/src/Project/DataAccess/EmployeeQueryBuilder.cs
@@ -20,15 +20,42 @@ public static class EmployeeQueryBuilder
     /// </summary>
     public static BuiltQuery BuildEmployeeSearch(int companyId, int? departmentId, int? positionId, string? lastName, string? firstName, string? middleName)
     {
-        throw new NotImplementedException("TODO");
+        var sql = SqlQueries.GetEmployeesBase;
+        var parameters = new List<SqlParameter> { new("@companyId", companyId) };
+
+        if (departmentId.HasValue)
+        {
+            sql += SqlQueries.AppendDepartmentFilter;
+            parameters.Add(new SqlParameter("@departmentId", departmentId.Value));
+        }
+
+        if (positionId.HasValue)
+        {
+            sql += SqlQueries.AppendPositionFilter;
+            parameters.Add(new SqlParameter("@positionId", positionId.Value));
+        }
+
+        AddNamePart(ref sql, parameters, "last_name", "@lastName", lastName);
+        AddNamePart(ref sql, parameters, "first_name", "@firstName", firstName);
+        AddNamePart(ref sql, parameters, "middle_name", "@middleName", middleName);
+
+        sql += SqlQueries.OrderEmployees;
+        return new BuiltQuery(sql, parameters);
     }
 
     /// <summary>Escapes <c>\ % _ [</c> with a backslash for use with <c>LIKE ... ESCAPE '\'</c>.</summary>
     public static string EscapeLike(string value) =>
-        throw new NotImplementedException("TODO");
+        value.Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_").Replace("[", "\\[");
 
     private static void AddNamePart(ref string sql, List<SqlParameter> parameters, string column, string parameter, string? value)
     {
-        throw new NotImplementedException("TODO");
+        var trimmed = value?.Trim();
+        if (string.IsNullOrEmpty(trimmed))
+        {
+            return;
+        }
+
+        sql += $" AND {column} LIKE '%' + {parameter} + '%' ESCAPE '\\'";
+        parameters.Add(new SqlParameter(parameter, EscapeLike(trimmed)));
     }
 }
